# Postgres — shared "retail" database used by orders-graycup / graycup-in-storefront.
# Orders written here (into the shared "order" table) automatically show up in the
# orders-graycup admin dashboard. Ask for the connection string to the same DB that
# orders-graycup's DATABASE_URL points at.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cashfree Payment Gateway — Orders API (hosted Checkout), same credential names
# orders-graycup uses. Get these from https://merchant.cashfree.com/merchants/apiKeys
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# "sandbox" to hit https://sandbox.cashfree.com/pg, anything else (or unset) = production
CASHFREE_ENV=sandbox

# Same value as CASHFREE_ENV, but readable client-side (Astro exposes PUBLIC_* to the
# browser) so the checkout page loads the matching Cashfree.js SDK mode.
PUBLIC_CASHFREE_MODE=sandbox

# Register https://<your-domain>/api/cashfree/webhook in the Cashfree dashboard
# (Developers -> Webhooks) for the "Payment" event group. CASHFREE_SECRET_KEY above
# is reused to verify webhook signatures — no separate secret needed.
