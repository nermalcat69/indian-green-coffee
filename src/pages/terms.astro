---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout
	title="Terms & Conditions | Indian Green Coffee"
	description="Terms and conditions for indiangreencoffee.com, a Gray Cup Enterprises property, including ordering and payment terms."
	showFooterCta={false}
	noindex={true}
>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="legal-page">
		<SiteHeader />

		<main id="main-content" class="legal-main">
			<header class="legal-header">
				<h1>Terms & Conditions</h1>
				<p class="legal-intro">
					These terms govern use of this website and orders placed through it. By accessing the
					site or placing an order, you agree to these terms.
				</p>
				<p class="legal-updated">Last updated: August 20, 2026</p>
			</header>

			<article class="legal-content">
				<section>
					<h2>General Use</h2>
					<p>
						The content on this website is provided for general information and presentation
						purposes. We make reasonable efforts to keep it accurate and current, but do not
						guarantee that all information will always be complete, error-free, or up to date.
					</p>
				</section>

				<section>
					<h2>Orders, Pricing & Payment</h2>
					<p>
						Products listed under <a href="/products">Coffees</a> are wholesale green coffee lots
						sold by the kilogram, subject to the stated minimum order quantity. All prices shown
						on this site are indicative FOB India rates in Indian Rupees (INR) and may be updated
						without notice; the price and total shown at checkout at the time of payment is the
						binding amount for that order.
					</p>
					<p>
						Payments are processed securely through Cashfree Payments. An order is confirmed only
						once payment is successfully captured. We reserve the right to decline or cancel an
						order — with a full refund of any amount paid — if a lot is unavailable or a pricing
						error is discovered.
					</p>
					<p>
						See our <a href="/refunds">Refunds & Cancellations</a> policy for how cancellations,
						payment failures, and quality issues are handled.
					</p>
				</section>

				<section>
					<h2>Intellectual Property</h2>
					<p>
						Unless otherwise stated, the content, design work, layouts, written materials, and
						visual assets on this site are the property of their respective owner and may not be
						reproduced, distributed, or reused without permission.
					</p>
					<p>
						Project names, logos, and trademarks referenced on this site remain the property of
						their respective owners.
					</p>
				</section>

				<section>
					<h2>External Links</h2>
					<p>
						This website may include links to third-party sites or services for convenience.
						Those destinations operate independently and are governed by their own terms and
						policies.
					</p>
				</section>

				<section>
					<h2>Contact</h2>
					<p>
						Questions about these terms can be directed to
						<a href="mailto:office@graycup.org">office@graycup.org</a>.
					</p>
				</section>
			</article>
		</main>
	</div>
</Layout>

<style>
	.legal-page {
		width: min(calc(100% - 3rem), 62rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.legal-main {
		padding: 5rem 0 0;
	}

	.legal-header {
		max-width: 46rem;
	}

	.legal-updated {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--muted-foreground);
	}

	.legal-updated {
		margin-top: 1.25rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 4.2vw, 3.9rem);
		line-height: 1.05;
		letter-spacing: -0.05em;
		font-weight: 800;
	}

	.legal-intro,
	.legal-content p {
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.legal-intro {
		margin: 1.5rem 0 0;
		color: var(--muted-foreground);
	}

	.legal-content {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.legal-content section + section {
		margin-top: 2.5rem;
	}

	h2 {
		margin: 0 0 0.85rem;
		font-size: 1.35rem;
		line-height: 1.2;
		letter-spacing: -0.03em;
	}

	.legal-content p {
		margin: 0;
		max-width: 46rem;
	}

	.legal-content p + p {
		margin-top: 1rem;
	}

	.legal-content a {
		color: inherit;
		font-weight: 700;
	}

	@media (max-width: 720px) {
		.legal-page {
			width: min(calc(100% - 1.5rem), 62rem);
			padding-top: 1rem;
		}

		.legal-main {
			padding-top: 4rem;
		}
	}
</style>
