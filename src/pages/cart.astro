---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout title="Cart | Indian Green Coffee" description="Review your wholesale green coffee order before checkout." noindex={true}>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<header class="hero">
				<p class="eyebrow">Cart</p>
				<h1 class="display-title" style="font-size: clamp(2.4rem, 4vw, 3.6rem);">Your order</h1>
			</header>

			<div data-cart-empty hidden>
				<p class="empty-text">
					Your cart is empty. Browse the <a href="/products">catalogue</a> to add a lot.
				</p>
			</div>

			<div class="cart-layout" data-cart-layout hidden>
				<div data-cart-list class="cart-list"></div>

				<aside class="cart-summary accent-card lime">
					<h2>Order summary</h2>
					<div data-cart-summary-items></div>
					<div class="summary-row">
						<span>Subtotal</span>
						<span data-cart-subtotal>₹0</span>
					</div>
					<p class="summary-note">
						Prices are indicative FOB India rates in INR per kg. Freight, duties, and export
						documentation are arranged separately after checkout.
					</p>
					<a class="checkout-button" href="/checkout">Continue to checkout</a>
				</aside>
			</div>
		</main>
	</div>
</Layout>

<script>
	import { getCart, removeItem, updateQty } from '../lib/cart';
	import { products } from '../data/products';

	const layoutEl = document.querySelector<HTMLElement>('[data-cart-layout]')!;
	const listEl = document.querySelector<HTMLElement>('[data-cart-list]')!;
	const emptyEl = document.querySelector<HTMLElement>('[data-cart-empty]')!;
	const summaryItemsEl = document.querySelector<HTMLElement>('[data-cart-summary-items]')!;
	const subtotalEl = document.querySelector<HTMLElement>('[data-cart-subtotal]')!;

	function fmt(n: number) {
		return `₹${n.toLocaleString('en-IN')}`;
	}

	function render() {
		const items = getCart();

		if (items.length === 0) {
			emptyEl.hidden = false;
			layoutEl.hidden = true;
			listEl.innerHTML = '';
			summaryItemsEl.innerHTML = '';
			return;
		}

		emptyEl.hidden = true;
		layoutEl.hidden = false;

		let subtotal = 0;
		const rows: string[] = [];
		const summaryRows: string[] = [];

		for (const item of items) {
			const product = products.find((p) => p.slug === item.slug);
			if (!product) continue;
			const lineTotal = Math.round(product.priceRange.min * item.qtyKg);
			subtotal += lineTotal;

			rows.push(`
				<article class="cart-item">
					<a class="cart-item-image-link" href="/products/${product.slug}">
						<img class="cart-item-image" src="${product.image.src}" alt="${product.imageAlt}" width="${product.image.width}" height="${product.image.height}" loading="lazy" />
					</a>
					<div class="cart-item-info">
						<p class="cart-item-name"><a href="/products/${product.slug}">${product.name}</a></p>
						<p class="cart-item-meta">${product.process}</p>
						<p class="cart-item-price">₹${product.priceRange.min}/kg · min ${product.minimumOrder.quantity}${product.minimumOrder.unit}</p>
					</div>
					<div class="cart-item-controls">
						<label class="qty-label" for="qty-${product.slug}">Qty (kg)</label>
						<input
							id="qty-${product.slug}"
							type="number"
							min="${product.minimumOrder.quantity}"
							step="1"
							value="${item.qtyKg}"
							data-qty-input
							data-slug="${product.slug}"
						/>
						<p class="cart-item-total">${fmt(lineTotal)}</p>
						<button type="button" data-remove data-slug="${product.slug}" aria-label="Remove ${product.name}">Remove</button>
					</div>
				</article>
			`);

			summaryRows.push(`
				<div class="summary-line">
					<span>${product.name} × ${item.qtyKg}kg</span>
					<span>${fmt(lineTotal)}</span>
				</div>
			`);
		}

		listEl.innerHTML = rows.join('');
		summaryItemsEl.innerHTML = summaryRows.join('');
		subtotalEl.textContent = fmt(subtotal);
	}

	listEl.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLElement)) return;
		const button = target.closest<HTMLElement>('[data-remove]');
		if (!button) return;
		const slug = button.dataset.slug;
		if (slug) {
			removeItem(slug);
			render();
		}
	});

	listEl.addEventListener('change', (event) => {
		const target = event.target;
		if (!(target instanceof HTMLInputElement) || !target.dataset.qtyInput) return;
		const slug = target.dataset.slug;
		if (!slug) return;
		const product = products.find((p) => p.slug === slug);
		const qty = Math.max(Number(target.value) || 0, product?.minimumOrder.quantity ?? 1);
		target.value = String(qty);
		updateQty(slug, qty);
		render();
	});

	render();
</script>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 72rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.hero {
		padding: 4rem 0 2.5rem;
	}

	.eyebrow {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}

	.empty-text {
		font-size: 1.05rem;
		color: var(--muted-foreground);
	}

	.empty-text a {
		color: var(--accent-link);
	}

	.cart-layout {
		display: grid;
		grid-template-columns: 1.5fr 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.cart-list {
		display: grid;
		gap: 1rem;
	}

	.cart-item {
		display: grid;
		grid-template-columns: 6rem 1fr auto;
		gap: 1.25rem;
		align-items: center;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: 1rem;
	}

	.cart-item-image-link {
		display: block;
		width: 6rem;
		height: 6rem;
		border-radius: 0.75rem;
		overflow: hidden;
		flex-shrink: 0;
	}

	.cart-item-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.cart-item-name {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
	}

	.cart-item-name a {
		text-decoration: none;
		color: inherit;
	}

	.cart-item-meta {
		margin: 0.3rem 0 0;
		font-size: 0.85rem;
		color: var(--muted-foreground);
	}

	.cart-item-price {
		margin: 0.3rem 0 0;
		font-size: 0.88rem;
		color: var(--muted-foreground);
	}

	.cart-item-controls {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
	}

	.qty-label {
		font-size: 0.75rem;
		color: var(--muted-foreground);
		align-self: flex-end;
	}

	.cart-item-controls input[type='number'] {
		width: 5rem;
		padding: 0.5rem 0.6rem;
		border: 1px solid var(--control-border);
		border-radius: 0.6rem;
	}

	.cart-item-total {
		margin: 0;
		min-width: 6rem;
		text-align: right;
		font-weight: 700;
	}

	.cart-item-controls button {
		padding: 0.5rem 0.85rem;
		border: 1px solid var(--control-border);
		border-radius: 0.6rem;
		cursor: pointer;
		font-weight: 600;
		font-size: 0.85rem;
		background: transparent;
	}

	.cart-item-controls button:hover {
		background: var(--muted);
	}

	.cart-summary {
		position: sticky;
		top: 2rem;
		padding: 1.75rem;
	}

	.cart-summary h2 {
		margin: 0 0 1rem;
		font-size: 1.15rem;
		font-weight: 800;
	}

	.summary-line {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 0;
		font-size: 0.9rem;
		border-bottom: 1px solid rgba(23, 23, 23, 0.14);
	}

	.summary-row {
		display: flex;
		justify-content: space-between;
		margin-top: 1rem;
		padding-top: 1rem;
		font-size: 1.15rem;
		font-weight: 800;
		border-top: 1px solid rgba(23, 23, 23, 0.24);
	}

	.summary-note {
		margin: 1rem 0 0;
		font-size: 0.85rem;
		line-height: 1.5;
		opacity: 0.75;
	}

	.checkout-button {
		display: block;
		margin-top: 1.5rem;
		padding: 0.95rem 1.6rem;
		background: #171717;
		color: #fff;
		border-radius: 999px;
		font-weight: 700;
		text-align: center;
		text-decoration: none;
	}

	.checkout-button:hover {
		opacity: 0.85;
	}

	@media (max-width: 820px) {
		.cart-layout {
			grid-template-columns: 1fr;
		}

		.cart-item {
			grid-template-columns: 4.5rem 1fr;
		}

		.cart-item-controls {
			grid-column: 1 / -1;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}

		.cart-summary {
			position: static;
		}
	}
</style>
