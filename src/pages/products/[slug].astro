---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { products, getProductBySlug } from '../../data/products';
import { getOriginBySlug } from '../../data/origins';
import { siteConfig } from '../../config/site';

export function getStaticPaths() {
	return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
// getStaticPaths above only ever generates params for known products, so this is always defined.
const product = getProductBySlug(slug as string)!;
const origin = getOriginBySlug(product.originSlug)!;

const pageUrl = `${siteConfig.siteUrl}/products/${product.slug}`;
const title = `${product.name} | Indian Green Coffee`;
const description = `${product.summary} ${product.process}, ${product.varietal}. ₹${product.priceRange.min}-${product.priceRange.max}${product.priceRange.unit} FOB India. MOQ ${product.minimumOrder.quantity}${product.minimumOrder.unit}.`;

const specs: Array<[string, string]> = [
	['Variety', product.variety],
	['Process', product.process],
	['Grade', product.grade],
	['Varietal', product.varietal],
	...(product.scaScore != null ? ([['SCA Score', String(product.scaScore)]] as Array<[string, string]>) : []),
	['Price (FOB India)', `₹${product.priceRange.min}–${product.priceRange.max}${product.priceRange.unit}`],
	['Minimum order', `${product.minimumOrder.quantity}${product.minimumOrder.unit}`],
	['SKU', product.sku],
];

const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.siteUrl },
			{ '@type': 'ListItem', position: 2, name: 'Coffees', item: `${siteConfig.siteUrl}/products` },
			{ '@type': 'ListItem', position: 3, name: product.name, item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Product',
		'@id': pageUrl,
		name: product.name,
		description: product.description,
		url: pageUrl,
		sku: product.sku,
		category: 'Green Coffee',
		countryOfOrigin: {
			'@type': 'Country',
			name: 'India',
		},
		brand: {
			'@type': 'Brand',
			name: 'Gray Cup Enterprises Private Limited',
		},
		...(product.scaScore != null && {
			additionalProperty: [
				{
					'@type': 'PropertyValue',
					name: 'SCA Score',
					value: product.scaScore,
				},
			],
		}),
		offers: {
			'@type': 'AggregateOffer',
			priceCurrency: 'INR',
			lowPrice: product.priceRange.min.toFixed(2),
			highPrice: product.priceRange.max.toFixed(2),
			offerCount: 1,
			availability: 'https://schema.org/InStock',
			itemCondition: 'https://schema.org/NewCondition',
			url: pageUrl,
			seller: {
				'@type': 'Organization',
				name: 'Gray Cup Enterprises Private Limited',
				url: siteConfig.siteUrl,
			},
		},
	},
];
---

<Layout title={title} description={description} schema={schema}>
	<a class="skip-link" href="#main-content">Skip to content</a>

	<div class="page">
		<SiteHeader />

		<main id="main-content">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/products">Coffees</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{product.name}</span>
			</nav>

			<div class="product-layout">
				<figure class="hero-image">
					<Image
						src={product.image}
						alt={product.imageAlt}
						loading="eager"
						decoding="async"
						widths={[480, 720, 1040]}
						sizes="(max-width: 900px) 100vw, 32rem"
					/>
				</figure>

				<div class="buy-column">
					<div class={`info-panel accent-card ${product.accent}`}>
						<p class="info-origin">
							<a href={`/origins/${origin.slug}`}>{origin.name}, {origin.state}</a>
						</p>
						<h1 class="info-title">{product.name}</h1>
						<p class="info-summary">{product.summary}</p>
						<p class="info-price">
							₹{product.priceRange.min}–{product.priceRange.max}{product.priceRange.unit}
							<span class="info-moq">min {product.minimumOrder.quantity}{product.minimumOrder.unit}</span>
						</p>
					</div>

					<table class="spec-table">
						<tbody>
							{
								specs.map(([label, value]) => (
									<tr>
										<th scope="row">{label}</th>
										<td>{value}</td>
									</tr>
								))
							}
						</tbody>
					</table>

					<section
						class="buy-box"
						data-product-card
						data-slug={product.slug}
						data-name={product.name}
						data-price={product.priceRange.min}
						data-min-qty={product.minimumOrder.quantity}
					>
						<div class="qty-row">
							<span class="qty-label">Quantity ({product.minimumOrder.unit})</span>
							<div class="qty-stepper">
								<button type="button" class="qty-btn" data-qty-dec aria-label={`Decrease quantity for ${product.name}`}>−</button>
								<input
									type="number"
									class="qty-value"
									data-qty-input
									min={product.minimumOrder.quantity}
									step={product.minimumOrder.quantity <= 10 ? 1 : 10}
									value={product.minimumOrder.quantity}
									aria-label={`Quantity in kg for ${product.name}`}
								/>
								<button type="button" class="qty-btn" data-qty-inc aria-label={`Increase quantity for ${product.name}`}>+</button>
							</div>
						</div>

						<div class="buy-box-actions">
							<button type="button" class="btn-buy-now" data-buy-now>
								Buy now · <span data-buy-now-total>₹{Math.round(product.priceRange.min * product.minimumOrder.quantity).toLocaleString('en-IN')}</span>
							</button>
							<button type="button" class="btn-add-cart" data-add-to-cart>
								Add to cart
							</button>
						</div>
						<p class="buy-box-note" data-add-to-cart-note hidden></p>
					</section>

					<p class="alt-contact">
						For samples, custom quotes, or shipping to your country, you can also reach us at
						<a href="https://bulkgreencoffee.com" target="_blank" rel="noopener noreferrer">bulkgreencoffee.com</a>
						or <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
					</p>
				</div>
			</div>

			<section class="description-section">
				<h2>About this lot</h2>
				<p>{product.description}</p>
			</section>
		</main>
	</div>
</Layout>

<script>
	import { addItem } from '../../lib/cart';

	function fmt(n: number) {
		return `₹${Math.round(n).toLocaleString('en-IN')}`;
	}

	document.querySelectorAll<HTMLElement>('[data-product-card]').forEach((card) => {
		const slug = card.dataset.slug;
		const pricePerKg = Number(card.dataset.price ?? 0);
		const minQty = Number(card.dataset.minQty ?? 1);
		const qtyInput = card.querySelector<HTMLInputElement>('[data-qty-input]');
		const decBtn = card.querySelector<HTMLButtonElement>('[data-qty-dec]');
		const incBtn = card.querySelector<HTMLButtonElement>('[data-qty-inc]');
		const buyNowTotal = card.querySelector<HTMLElement>('[data-buy-now-total]');
		const addBtn = card.querySelector<HTMLButtonElement>('[data-add-to-cart]');
		const buyBtn = card.querySelector<HTMLButtonElement>('[data-buy-now]');
		const note = card.querySelector<HTMLElement>('[data-add-to-cart-note]');
		if (!slug || !qtyInput) return;

		const step = Number(qtyInput.step) || 1;

		function currentQty(): number {
			return Math.max(Number(qtyInput!.value) || 0, minQty);
		}

		function syncTotal() {
			if (buyNowTotal) buyNowTotal.textContent = fmt(pricePerKg * currentQty());
		}

		function setQty(next: number) {
			const clamped = Math.max(minQty, next);
			qtyInput!.value = String(clamped);
			syncTotal();
		}

		decBtn?.addEventListener('click', () => setQty(currentQty() - step));
		incBtn?.addEventListener('click', () => setQty(currentQty() + step));
		qtyInput.addEventListener('change', () => setQty(currentQty()));

		addBtn?.addEventListener('click', () => {
			const qty = currentQty();
			addItem(slug, qty);
			if (note) {
				note.hidden = false;
				note.textContent = `${qty}kg added to cart.`;
				window.setTimeout(() => {
					note.hidden = true;
				}, 2500);
			}
		});

		buyBtn?.addEventListener('click', () => {
			addItem(slug, currentQty());
			window.location.href = '/checkout';
		});
	});
</script>

<style>
	.page {
		position: relative;
		width: min(calc(100% - 3rem), 78rem);
		margin: 0 auto;
		padding: 1.25rem 0 5rem;
	}

	.breadcrumb {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		margin: 2rem 0 0;
		font-size: 0.9rem;
		color: var(--muted-foreground);
	}

	.breadcrumb a {
		color: inherit;
		text-decoration: none;
	}

	.breadcrumb a:hover,
	.breadcrumb a:focus-visible {
		text-decoration: underline;
	}

	.product-layout {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 3rem;
		align-items: start;
		margin-top: 2rem;
	}

	.hero-image {
		position: sticky;
		top: 2rem;
		margin: 0;
	}

	.hero-image :global(img) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 1.25rem;
		box-shadow: var(--shadow-soft);
	}

	.buy-column {
		display: grid;
		gap: 1.5rem;
	}

	.info-panel {
		padding: 1.75rem;
	}

	.info-origin {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.72;
	}

	.info-origin a {
		color: inherit;
	}

	.info-title {
		margin: 0.6rem 0 0;
		font-size: clamp(1.6rem, 2.4vw, 2.1rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
	}

	.info-summary {
		margin: 0.85rem 0 0;
		font-size: 1rem;
		line-height: 1.55;
	}

	.info-price {
		margin: 1.1rem 0 0;
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		flex-wrap: wrap;
		font-size: 1.3rem;
		font-weight: 800;
	}

	.info-moq {
		font-size: 0.8rem;
		font-weight: 600;
		opacity: 0.68;
	}

	.spec-table {
		width: 100%;
		border-collapse: collapse;
		border: 1px solid var(--border);
		border-radius: 1rem;
		overflow: hidden;
		font-size: 0.92rem;
	}

	.spec-table tr:not(:last-child) th,
	.spec-table tr:not(:last-child) td {
		border-bottom: 1px solid var(--border);
	}

	.spec-table th,
	.spec-table td {
		padding: 0.75rem 1rem;
		text-align: left;
	}

	.spec-table th {
		width: 45%;
		font-weight: 600;
		color: var(--muted-foreground);
	}

	.spec-table td {
		font-weight: 700;
	}

	.buy-box {
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 1rem;
	}

	.qty-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.qty-label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted-foreground);
	}

	.qty-stepper {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--control-border);
		border-radius: 0.75rem;
		overflow: hidden;
	}

	.qty-btn {
		width: 2.6rem;
		height: 2.6rem;
		display: grid;
		place-items: center;
		background: transparent;
		border: none;
		font-size: 1.2rem;
		font-weight: 700;
		color: inherit;
		cursor: pointer;
	}

	.qty-btn:hover {
		background: var(--muted);
	}

	.qty-value {
		width: 4rem;
		text-align: center;
		border: none;
		border-left: 1px solid var(--control-border);
		border-right: 1px solid var(--control-border);
		background: transparent;
		font-size: 1rem;
		font-weight: 800;
		color: inherit;
		padding: 0.6rem 0;
		-moz-appearance: textfield;
	}

	.qty-value::-webkit-outer-spin-button,
	.qty-value::-webkit-inner-spin-button {
		-webkit-appearance: none;
		margin: 0;
	}

	.buy-box-actions {
		display: grid;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	.btn-buy-now,
	.btn-add-cart {
		padding: 0.9rem 1.5rem;
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.98rem;
		cursor: pointer;
		text-align: center;
	}

	.btn-buy-now {
		background: var(--foreground);
		color: var(--background);
		border: 1px solid var(--foreground);
	}

	.btn-buy-now:hover {
		opacity: 0.85;
	}

	.btn-add-cart {
		background: transparent;
		color: inherit;
		border: 1px solid var(--control-border);
	}

	.btn-add-cart:hover {
		background: var(--muted);
	}

	.buy-box-note {
		margin: 0.9rem 0 0;
		font-size: 0.88rem;
		font-weight: 700;
		text-align: center;
	}

	.alt-contact {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--muted-foreground);
	}

	.alt-contact a {
		color: var(--accent-link);
	}

	.description-section {
		max-width: 46rem;
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}

	.description-section h2 {
		margin: 0 0 0.85rem;
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.description-section p {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--muted-foreground);
	}

	@media (max-width: 900px) {
		.product-layout {
			grid-template-columns: 1fr;
		}

		.hero-image {
			position: static;
			max-width: 32rem;
		}
	}

	@media (max-width: 720px) {
		.page {
			width: min(calc(100% - 1.5rem), 78rem);
		}
	}
</style>
